# Copy to .env. Matches docker-compose.yml (local development only).
# The API and the worker check these at start and list every problem (apps/api/src/config.ts).
# NODE_ENV=production also requires ALLOWED_GRAPHQL_ORIGINS, ALLOWED_CLIENT_HOSTS and PUBLIC_URL and
# refuses the development secrets below (SECRET_KEY, AWS_SECRET_ACCESS_KEY).
DATABASE_URL=postgres://commerce:commerce@localhost:5433/commerce
# Integration tests (apps/api). Must end in _test: the test setup refuses anything else.
DATABASE_URL_TEST=postgres://commerce:commerce@localhost:5433/commerce_test
# Product media (ADR-0014): the local S3 server from docker-compose (SeaweedFS). Dev-only credentials,
# as in infra/seaweedfs/s3.json. In production: unset AWS_S3_ENDPOINT_URL and use AWS credentials.
AWS_MEDIA_BUCKET_NAME=commerce-media
AWS_MEDIA_BUCKET_NAME_TEST=commerce-media-test
AWS_S3_ENDPOINT_URL=http://localhost:8333
AWS_S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=commerce
AWS_SECRET_ACCESS_KEY=commerce-dev-secret
MEDIA_PUBLIC_URL=http://localhost:8333/commerce-media
# Browser origins allowed to call the API (comma-separated). Default: the dashboard dev server.
ALLOWED_GRAPHQL_ORIGINS=http://localhost:5173

# Absolute base URL of the API for thumbnail links (Saleor's variable); unset uses the request origin.
# PUBLIC_URL=http://localhost:4000

# Email (PLAN M8; Saleor's variable names). The worker sends through this SMTP server: Mailpit from
# docker-compose in dev (web UI on http://localhost:8026).
EMAIL_URL=smtp://localhost:1026
DEFAULT_FROM_EMAIL=noreply@example.com

# Signs account confirmation links (PLAN M8.3; Saleor's setting). At least 32 characters; the API
# and the worker must share it. Generate one with: openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
# Hosts a confirmation redirectUrl may point to (comma-separated; ".example.com" allows
# subdomains). Unset: localhost and 127.0.0.1, as Saleor in DEBUG.
# ALLOWED_CLIENT_HOSTS=localhost,127.0.0.1

# Logs (PLAN M9.2): JSON lines when NODE_ENV=production or LOG_JSON=true, readable output otherwise.
# LOG_LEVEL=debug also logs each step of a GraphQL request (default: info).
# LOG_JSON=true
# LOG_LEVEL=info
