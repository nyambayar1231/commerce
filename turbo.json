{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "schema:print": {
      "inputs": ["src/**"],
      "outputs": ["schema.graphql"]
    },
    "codegen": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/schema.graphql"],
      "outputs": ["src/graphql/*.generated.ts"]
    }
  }
}
