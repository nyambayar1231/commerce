# Copy to .env.prod for docker-compose.prod.yml (PLAN M9.6) and replace every "change-me" value.
# The API and the worker refuse to start with development secrets (apps/api/src/config.ts).

# Postgres (the stack's own container; use your managed database's URL otherwise).
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://commerce:change-me-postgres-password@postgres:5432/commerce

# Signs account confirmation links; at least 32 characters: openssl rand -hex 32
SECRET_KEY=change-me-run-openssl-rand-hex-32-and-paste-here

# The public address of the stack (the `web` container, published on port 8080 by default).
PUBLIC_URL=http://localhost:8080
ALLOWED_GRAPHQL_ORIGINS=http://localhost:8080
# Hosts a storefront's confirmation link (accountRegister's redirectUrl) may point to.
ALLOWED_CLIENT_HOSTS=localhost
# The API sits behind the web container's nginx: trust the X-Forwarded-For entry it adds.
TRUST_PROXY=true

# Product media. With the local-services profile, the stack's SeaweedFS stands in for S3 and takes
# these credentials (the s3 service writes its config from them). For AWS S3: remove
# AWS_S3_ENDPOINT_URL and use real credentials (or none, with an instance role) and the bucket's
# public URL (see docs/deploy.md).
AWS_MEDIA_BUCKET_NAME=commerce-media
AWS_S3_ENDPOINT_URL=http://s3:8333
AWS_S3_REGION_NAME=ap-northeast-2
AWS_ACCESS_KEY_ID=commerce
AWS_SECRET_ACCESS_KEY=change-me-s3-secret
MEDIA_PUBLIC_URL=http://localhost:8080/media/commerce-media

# Email. With the local-services profile, the stack's Mailpit catches everything (UI on
# http://localhost:8027); use a real SMTP server in production, e.g.
# smtps://user:password@smtp.example.com:465
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=noreply@example.com
