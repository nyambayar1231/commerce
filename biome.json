{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/*.md",
      "!packages/db/drizzle",
      "!apps/api/schema.graphql",
      "!apps/dashboard/src/assets",
      "!**/*.generated.ts",
      "!apps/storefront/src/gql"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": ["apps/storefront/src/ui/**", "apps/storefront/src/checkout/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/gql", "@/gql/**", "@/lib/**", "!@/lib/utils", "!@/lib/*/types"],
                    "message": "src/ui and src/checkout/components import only @/lib/utils and @/lib/*/types (view models): no API, generated types, loaders or Server Actions; pages pass data and actions as props (ARCHITECTURE §10.3)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/storefront/**/*.css"],
      "css": { "parser": { "tailwindDirectives": true } },
      "linter": { "rules": { "suspicious": { "noUnknownAtRules": "off" } } }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
