{
  "name": "@commerce/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "test": "vitest run",
    "schema:print": "node src/print-schema-cli.ts",
    "cli": "node --env-file-if-exists=../../.env src/cli.ts",
    "worker": "node --env-file-if-exists=../../.env src/worker.ts"
  },
  "devDependencies": {
    "@commerce/tsconfig": "workspace:*",
    "postgres": "3.4.9",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@commerce/contracts": "workspace:*",
    "@commerce/db": "workspace:*",
    "@graphql-hive/logger": "1.1.1",
    "@graphql-yoga/plugin-csrf-prevention": "4.0.1",
    "@node-rs/argon2": "2.2.2",
    "@pothos/core": "4.16.0",
    "@pothos/plugin-relay": "4.8.1",
    "dataloader": "2.2.3",
    "drizzle-orm": "0.45.4",
    "graphql": "17.1.0",
    "graphql-yoga": "6.0.1",
    "nodemailer": "10.3.1",
    "pg-boss": "12.38.0",
    "sharp": "0.35.5"
  }
}
