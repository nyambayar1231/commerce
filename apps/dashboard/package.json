{
  "name": "@commerce/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "codegen": "graphql-codegen --config codegen.ts",
    "extract-messages": "formatjs extract 'src/**/*.{ts,tsx}' --ignore '**/*.d.ts' --ignore '**/*.test.*' --out-file locale/defaultMessages.json --format scripts/formatter.cjs"
  },
  "devDependencies": {
    "@commerce/tsconfig": "workspace:*",
    "@formatjs/cli": "6.18.2",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/typed-document-node": "8.0.0",
    "@graphql-codegen/typescript": "7.0.0",
    "@graphql-codegen/typescript-operations": "7.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/apollo-upload-client": "18.0.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@apollo/client": "3.14.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@glideapps/glide-data-grid": "5.3.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@saleor/macaw-ui": "3.1.0",
    "apollo-upload-client": "18.0.1",
    "graphql": "16.15.0",
    "lodash": "4.18.1",
    "lucide-react": "0.555.0",
    "marked": "4.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "12.1.6",
    "react-responsive-carousel": "3.2.23",
    "react-router": "7.18.5",
    "sonner": "2.0.7"
  }
}
