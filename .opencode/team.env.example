# Model selection for the OpenCode workers started by scripts/ai/spawn.sh.
#
# Copy to .opencode/team.env (gitignored) and fill in. No model ID is committed anywhere else:
# agent files in .opencode/agents/ deliberately have no `model`, and spawn.sh passes the model
# for the role at launch time.
#
# List the models your OpenCode Go subscription offers:   scripts/ai/models.sh
# Check that each choice actually answers:                scripts/ai/doctor.sh --live
# Values use OpenCode's `provider/model` (optionally `#variant`) format, e.g. opencode-go/<id>.
# Prefer `opencode-go/...` models: other providers (e.g. `opencode/...`) may bill a different
# account.

# backend-researcher, dashboard-researcher
OC_MODEL_RESEARCH=

# backend-implementer (apps/api, packages/*)
OC_MODEL_BACKEND=

# dashboard-implementer (apps/dashboard)
OC_MODEL_DASHBOARD=

# test-debugger
OC_MODEL_TEST=

# code-reviewer, security-reviewer (first pass). Pick a model from a DIFFERENT family than the
# implementers so the review is independent of the author. The final review runs on Claude
# Opus (.claude/agents/opus-*.md).
OC_MODEL_REVIEW=
