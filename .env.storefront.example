# The storefront's own variables (docs/deploy.md, "Storefront"). Copy to .env.storefront on the
# server (mode 600). Nothing here is secret; it never sees .env.prod.
# The API on the Compose network (no trailing slash).
API_URL=http://api:4000
# The public origin of the storefront (scheme://host, no path).
STOREFRONT_URL=https://dino-craft.lol
# Caddy sets X-Forwarded-For itself, so the last entry is the real client.
TRUST_PROXY=true
# Comma-separated origins allowed in the CSP for images: the API's public origin (thumbnails, e.g.
# https://admin.dino-craft.lol) and the media bucket's public origin (what thumbnails redirect to).
IMAGE_ORIGINS=
# Payment methods shown at checkout; empty until Wire is live, then "wire" (docs/deploy.md).
PAYMENT_PROVIDERS=
# Origin of Wire's hosted payment page (the default is right).
WIRE_CHECKOUT_ORIGIN=https://pay.wire.mn
